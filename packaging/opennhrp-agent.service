[Unit]
Description=OpenNHRP Management Agent
After=network-online.target opennhrp.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/opennhrp-agent/agent.env
ExecStart=/usr/sbin/opennhrp-agent --server ${SERVER} --node-id ${NODE_ID} --node-type ${NODE_TYPE} --token ${TOKEN}
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
