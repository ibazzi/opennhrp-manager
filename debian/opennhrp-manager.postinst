#!/bin/sh
set -e

if [ "$1" = configure ]; then
    install -d -m 0700 /etc/opennhrp-manager
    if [ ! -e /etc/opennhrp-manager/manager.env ]; then
        token="$(od -An -tx1 -N32 /dev/urandom | tr -d ' \n')"
        umask 077
        cat > /etc/opennhrp-manager/manager.env <<EOF
BIND_HOST=127.0.0.1
PORT=8080
DB_PATH=/var/lib/opennhrp-manager/database.db
AUTH_TOKEN=$token
WITNESS_ENABLED=1
EOF
    fi
fi

#DEBHELPER#
